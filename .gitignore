# books/ holds personally purchased or licensed PDFs (textbooks, course notes).
# They are indexed in reference/INDEX.md by title only; the files stay local.
books/
*.djvu
*.epub

# Third-party reference PDFs are fetched by scripts/fetch-references.sh at need.
# They are redistributable only under their own licenses, so we link, not vendor.
reference/**/*.pdf
!reference/**/.gitkeep

