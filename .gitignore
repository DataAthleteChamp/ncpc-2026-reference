# ---------------------------------------------------------------------------
# Copyrighted material — NEVER commit.
# ---------------------------------------------------------------------------
# books/ holds personally purchased or licensed PDFs (textbooks, course notes).
# They are indexed in reference/INDEX.md by title only; the files stay local.
books/
*.djvu
*.epub

# Third-party reference material is fetched by scripts/fetch-references.sh at
# need. It is redistributable only under its own licences — most Polish CP
# material is all-rights-reserved — so we link, never vendor. Ignore
# everything fetched into reference/, and allow only the indexes we write.
reference/en/*
reference/pl/*
!reference/en/README.md
!reference/pl/README.md

# ---------------------------------------------------------------------------
# Contest scratch — solutions are written in the repo root during a contest
# ---------------------------------------------------------------------------
# sol.cpp, in.txt and run are TRACKED: they are the ready-to-use workspace.
# Root-level a.cpp..l.cpp are per-contest working state and stay local --
# during a contest you are on one shared machine anyway (ICPC rules).
#
# To SHARE a solution with the team, move it to solutions/, which is tracked.
/[a-l].cpp
/[a-l]_brut.cpp
/[a-l]
/[a-l].bin
/[a-l].dbg
/[a-l].judge
/[a-l]_brut
/[a-l].*.in
/[a-l].*.ans
/[a-l].in
/[a-l].out
/sol.bin
/sol.dbg
/sol.judge
/sol_brut.cpp
/sol_brut
/sol.*.in
/sol.*.ans
/gen.py
/out.txt
/err.txt
/stress.in
/stress.got
/stress.exp

# Binaries inside solutions/ (the sources there are tracked).
solutions/**/*.bin
solutions/**/*.out
solutions/**/*.dbg

# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
# LaTeX intermediates live in build/. The finished PDF is published to
# print/team-reference.pdf, which IS tracked: it is entirely our own
# MIT-licensed content, and a teammate should not need a ~5 GB LaTeX install
# to read the document they are meant to print.
build/
*.o
a.out
*.dSYM/
__pycache__/

# LaTeX
*.aux
*.log
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store

.idea/
*.swp
